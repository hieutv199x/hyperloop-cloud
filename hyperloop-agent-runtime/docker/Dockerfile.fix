# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=hyperloop/kiro-agent-base:local
ARG VERSION=0.1.0
ARG REVISION=unknown
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="hyperloop-kiro-agent-fix" \
      org.opencontainers.image.description="Hyperloop Fix Job — same MR source branch, max 2 attempts" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"

USER root
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssh-client \
  && rm -rf /var/lib/apt/lists/* \
  && chown -R node:node /workspace
USER node

ENV HYPERLOOP_IMAGE_ROLE=fix \
    HYPERLOOP_ROLE=fix
