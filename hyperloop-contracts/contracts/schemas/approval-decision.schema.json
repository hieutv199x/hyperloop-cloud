{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperloop.dev/schemas/approval-decision.schema.json",
  "title": "ApprovalDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflowId",
    "approvedSpecHash",
    "approver",
    "decision",
    "expectedVersion"
  ],
  "properties": {
    "workflowId": { "type": "string", "minLength": 1 },
    "approvedSpecHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entraId", "displayName"],
      "properties": {
        "entraId": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" }
      }
    },
    "decision": {
      "type": "string",
      "enum": ["APPROVED", "SPEC_CHANGES_REQUESTED", "REJECTED"]
    },
    "expectedVersion": { "type": "integer", "minimum": 1 },
    "comment": { "type": "string" }
  }
}
