{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperloop.dev/schemas/implementation-spec.schema.json",
  "title": "ImplementationSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "type": "string", "const": "hyperloop.dev/v1" },
    "kind": { "type": "string", "const": "ImplementationSpec" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowId", "specHash", "revision", "sourceDevSpecRevision"],
      "properties": {
        "workflowId": { "type": "string", "minLength": 1 },
        "specHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "revision": { "type": "integer", "minimum": 1 },
        "sourceDevSpecRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["services", "dag"],
      "properties": {
        "summary": { "type": "string" },
        "services": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "workingBranch", "targetBranch", "changeSummary"],
            "properties": {
              "repository": { "type": "string", "minLength": 1 },
              "workingBranch": { "type": "string", "minLength": 1 },
              "targetBranch": {
                "type": "string",
                "pattern": "^release/[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "changeSummary": { "type": "string", "minLength": 1 },
              "dependsOn": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "dag": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodes", "edges"],
          "properties": {
            "nodes": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to"],
                "properties": {
                  "from": { "type": "string", "minLength": 1 },
                  "to": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
