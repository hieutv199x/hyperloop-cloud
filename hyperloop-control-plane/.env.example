PORT=8080
NODE_ENV=development
AWS_REGION=ap-southeast-1
DYNAMODB_TABLE=hyperloop-workflows
ARTIFACTS_BUCKET=hyperloop-artifacts
GLOBAL_MAX_CONCURRENT_JOBS=100
AGENT_NAMESPACE=hyperloop-agents
# Comma-separated Entra IDs, or * for local/dev only
APPROVER_ALLOWLIST=*
# Do not put real GitLab/Jenkins/Nexus/Teams credentials in git.
