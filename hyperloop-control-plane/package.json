{
  "name": "@hyperloop/control-plane",
  "version": "0.1.0",
  "description": "Hyperloop Cloud control plane — workflow orchestration, scheduler, admission",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.758.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/client-sqs": "^3.758.0",
    "@aws-sdk/lib-dynamodb": "^3.758.0",
    "@hyperloop/agent-runtime": "file:../hyperloop-agent-runtime",
    "@hyperloop/contracts": "file:../hyperloop-contracts",
    "@hyperloop/integrations": "file:../hyperloop-integrations",
    "@kubernetes/client-node": "^1.1.2",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
